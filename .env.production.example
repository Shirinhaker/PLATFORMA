# Modular production namunasi. Haqiqiy sirlarni repozitoriyga yozmang.
KOPRIK_ENVIRONMENT=production
KOPRIK_SERVICE_NAME=koprik-api
KOPRIK_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
KOPRIK_DB_POOL_SIZE=10
KOPRIK_DB_MAX_OVERFLOW=10
KOPRIK_DB_POOL_TIMEOUT_SECONDS=3
KOPRIK_WORKER_DB_POOL_SIZE=3
KOPRIK_WORKER_DB_MAX_OVERFLOW=2
KOPRIK_WORKER_DB_POOL_TIMEOUT_SECONDS=3
KOPRIK_REDIS_URL=redis://default:PASSWORD@HOST:6379/0
KOPRIK_REDIS_MAX_CONNECTIONS=100
KOPRIK_CORS_ORIGINS=https://koprik.uz,https://admin.koprik.uz

KOPRIK_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
KOPRIK_R2_BUCKET=koprik-production
KOPRIK_R2_ACCESS_KEY_ID=REPLACE_ME
KOPRIK_R2_SECRET_ACCESS_KEY=REPLACE_ME

KOPRIK_TELEGRAM_BOT_TOKEN=REPLACE_ME
KOPRIK_TELEGRAM_BOT_USERNAME=REPLACE_ME
KOPRIK_TELEGRAM_WEBHOOK_SECRET=GENERATE_A_RANDOM_SECRET
KOPRIK_OTP_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
KOPRIK_ADMIN_OTP_SECRET=GENERATE_A_DIFFERENT_ADMIN_SECRET
KOPRIK_CSRF_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
KOPRIK_OUTBOX_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
KOPRIK_ADMIN_TELEGRAM_IDS=YOUR_ADMIN_TELEGRAM_ID
KOPRIK_ADMIN_AUDIT_IP_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET

KOPRIK_LISTINGS_ENABLED=true
KOPRIK_STORIES_ENABLED=true
KOPRIK_CHAT_ENABLED=true
KOPRIK_TAXI_ENABLED=true
KOPRIK_PHASE3C_PUBLIC_ENABLED=true

# Ixtiyoriy integratsiyalar.
KOPRIK_FIREBASE_SERVICE_ACCOUNT_JSON=
KOPRIK_OPENAI_API_KEY=
KOPRIK_OPENAI_MODEL=gpt-4o-mini
