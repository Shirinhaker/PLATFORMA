# Modular production namuna. Haqiqiy sirlarni repozitoriy yoki ZIP ichiga yozmang.
# Railway variables ichida qiymatlarni alohida sozlang.

KOPRIK_ENVIRONMENT=production
KOPRIK_SERVICE_NAME=koprik-api

# PostgreSQL
KOPRIK_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
KOPRIK_DB_POOL_SIZE=10
KOPRIK_DB_MAX_OVERFLOW=10
KOPRIK_DB_POOL_TIMEOUT_SECONDS=3

# Redis
KOPRIK_REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
KOPRIK_REDIS_MAX_CONNECTIONS=100

# Frontend originlari. Faqat HTTPS originlar, vergul bilan ajratiladi.
KOPRIK_CORS_ORIGINS=https://koprik.uz,https://www.koprik.uz,https://admin.koprik.uz

# Cloudflare R2 / S3-compatible object storage
KOPRIK_R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
KOPRIK_R2_BUCKET=koprik-production
KOPRIK_R2_ACCESS_KEY_ID=SET_IN_RAILWAY
KOPRIK_R2_SECRET_ACCESS_KEY=SET_IN_RAILWAY

# Telegram auth
KOPRIK_TELEGRAM_BOT_TOKEN=SET_IN_RAILWAY
KOPRIK_TELEGRAM_BOT_USERNAME=YOUR_BOT_USERNAME
KOPRIK_TELEGRAM_WEBHOOK_SECRET=GENERATE_A_RANDOM_SECRET
KOPRIK_OTP_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
KOPRIK_CSRF_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
KOPRIK_OUTBOX_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY

# Session va cache
KOPRIK_AUTH_COOKIE_NAME=koprik_session
KOPRIK_SESSION_TTL_SECONDS=2592000
KOPRIK_SESSION_CACHE_TTL_SECONDS=30
KOPRIK_PROFILE_SUMMARY_CACHE_TTL_SECONDS=30
KOPRIK_PUBLIC_SEARCH_CACHE_TTL_SECONDS=30

# Feature flags
KOPRIK_LISTINGS_ENABLED=true
KOPRIK_STORIES_ENABLED=true
KOPRIK_CHAT_ENABLED=true
KOPRIK_TAXI_ENABLED=true
KOPRIK_PHASE3C_PUBLIC_ENABLED=true

# Admin — oddiy foydalanuvchi OTP siridan alohida bo‘lishi shart.
KOPRIK_ADMIN_TELEGRAM_IDS=YOUR_ADMIN_TELEGRAM_ID
KOPRIK_ADMIN_OTP_SECRET=GENERATE_A_DEDICATED_ADMIN_SECRET
KOPRIK_ADMIN_COOKIE_NAME=koprik_admin_session
KOPRIK_ADMIN_AUDIT_IP_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET

# Push notification (ixtiyoriy)
KOPRIK_FIREBASE_SERVICE_ACCOUNT_JSON=
KOPRIK_FIREBASE_SERVICE_ACCOUNT_PATH=

# OpenAI (ixtiyoriy)
KOPRIK_OPENAI_API_KEY=
KOPRIK_OPENAI_MODEL=gpt-4o-mini
KOPRIK_OPENAI_TIMEOUT_SECONDS=45

# Frontend Railway build uchun API origin.
# Bu qiymat frontend service variables ichida bo‘ladi.
KOPRIK_API_BASE_URL=https://platforma-production-f753.up.railway.app

# Eslatma:
# - SQLite DB_PATH/UPLOAD_DIR/BACKUP_DIR endi production runtime konfiguratsiyasi emas.
# - PostgreSQL backup/restore Railway/PostgreSQL siyosati bilan alohida boshqariladi.
# - R2 bucket lifecycle va backup siyosatini Cloudflare tomonida sozlang.
